config {
  output_dir        = "/media/encoded"
  user_presets      = "/Users/bob/Library/Containers/fr.handbrake.HandBrake/Data/Library/Application Support/HandBrake/UserPresets.json"
  handbrake_cli     = "/opt/homebrew/bin/HandBrakeCLI"

  # Optional: ffprobe binary used to inspect tracks of review-watch files.
  # Default: resolved from PATH.
  # ffprobe_cli      = "/opt/homebrew/bin/ffprobe"
  log_file          = "/Users/bob/Library/Logs/brakelight.log"
  scan_interval     = "30s"
  partial_extension = ".partial"
  max_attempts      = 3
  listen_addr       = ":8080"

  # Optional: default preset for watch blocks without an explicit preset.
  default_preset    = "Standard"

  # Optional: subtitle selection rule pre-filled in the track picker of
  # review-watch jobs that have no stored selection yet. One of "all",
  # "none", "original", "lang:eng,ita", "tracks:1,3". Watch blocks inherit
  # this value unless they set their own subtitle_rule.
  # Default: "original" when the file's original language is known, else "all".
  # subtitle_rule     = "all"

  # Optional: custom location for the queue database.
  db_file           = "/data/brakelight/myqueue.db"
}

# A minimal setup that inherits default values from the config block.
watch "General" {
  path   = "/media/general"
}

# A review watch: files are probed with ffprobe when queued, and the encode
# waits until audio/subtitle tracks are chosen per file (or in bulk) in the
# web UI. The UI pre-selects the original-language audio track when the file
# marks one, and the subtitle rule from config.subtitle_rule (or this watch's
# own subtitle_rule) when set. Default: false.
watch "Review" {
  path   = "/media/review"
  review = true

  # Optional: subtitle rule for this watch only, overriding
  # config.subtitle_rule.
  # subtitle_rule = "lang:eng,swe"
}

watch "Animated" {
  path   = "/media/animated"

  # Optional: use a different Handbrake preset.
  preset = "Animated"

  # Optional: overrides config.output_dir
  output_dir = "/media/encoded/animated"

  # Optional: shell commands run before each encode starts.
  # {output} is the full path, {output_path} is its directory,
  # {output_file} is its basename.
  # Commands run with /bin/sh -c; failures are logged and shown in the
  # UI, but do not affect the job status unless fail_on_pre_command_error
  # is set.
  pre_commands = [
    "logger 'Starting: {output_file}'",
  ]

  # Optional: fail the job (skip the encode) when a pre-command fails.
  # Default: false.
  # fail_on_pre_command_error = true

  # Optional: shell commands run after each encode completes.
  # Uses the same placeholders as pre_commands. Failures are logged and
  # shown in the UI, but do not affect the job status.
  post_commands = [
    "logger 'Encoded: {output_file}'",
  ]
}
