config {
  output_dir        = "/media/encoded"
  user_presets      = "/Users/bob/Library/Containers/fr.handbrake.HandBrake/Data/Library/Application Support/HandBrake/UserPresets.json"
  handbrake_cli     = "/opt/homebrew/bin/HandBrakeCLI"
  log_file          = "/Users/bob/Library/Logs/brakelight.log"
  scan_interval     = "30s"
  partial_extension = ".partial"
  max_attempts      = 3
  listen_addr       = ":8080"
}

watch "General" {
  path   = "/media/general"
  preset = "Standard"
}

watch "Animated" {
  path   = "/media/animated"
  preset = "Animated"

  # Optional: overrides config.output_dir
  output_dir = "/media/encoded/animated"

  # Optional: shell commands run before each encode starts.
  # Same placeholders and behavior as post_commands, except that the
  # output file does not exist yet at this point.
  pre_commands = [
    "logger 'Starting: {output_file}'",
  ]

  # Optional: shell commands run after each encode completes.
  # {output} is the full path, {output_path} is its directory,
  # {output_file} is its basename.
  # Commands run with /bin/sh -c; failures are logged but do not
  # affect the job status.
  post_commands = [
    "logger 'Encoded: {output_file}'",
  ]
}
